{
  "name": "vue-gerbera",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "serve": "vite",
    "build": "yarn type-check && vite build",
    "type-check": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "test:unit": "vitest run",
    "lint": "eslint --fix ."
  },
  "dependencies": {
    "vue": "2.7.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^1.3.6",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-template-compiler": "2.7.16",
    "vue-tsc": "~3.0.11"
  }
}
